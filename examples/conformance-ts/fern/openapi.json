{
  "info": {
    "title": "Conformance",
    "version": "1.0.0",
    "description": "Every Fern feature we care about, via standard OpenAPI + x-fern-* extensions."
  },
  "servers": [
    {
      "url": "https://charter-conformance-ts-api.gedw99.workers.dev",
      "description": "The deployed API (mode api). Fern's CLI takes its OAuth token URL from here; --base-url doesn't move it."
    }
  ],
  "security": [
    {
      "bearer": [
        "read"
      ]
    },
    {
      "accessClientId": [
        "read"
      ],
      "accessClientSecret": []
    },
    {
      "oidc": [
        "read"
      ]
    },
    {
      "OAuth": [
        "read"
      ]
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "accessClientId": {
        "type": "apiKey",
        "in": "header",
        "name": "CF-Access-Client-Id",
        "description": "A Cloudflare Access service token's Client ID: a machine's own (cf zero-trust access service-tokens create)",
        "x-fern-header": {
          "name": "accessClientId",
          "env": "CONFORMANCE_ACCESS_CLIENT_ID"
        }
      },
      "accessClientSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "CF-Access-Client-Secret",
        "description": "The service token's Client Secret",
        "x-fern-header": {
          "name": "accessClientSecret",
          "env": "CONFORMANCE_ACCESS_CLIENT_SECRET"
        }
      },
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "/.well-known/openid-configuration",
        "description": "An access token from the OpenID Connect issuer the deployment trusts (OIDC_ISSUER), with the operation's scopes"
      },
      "OAuth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/api/oauth/token",
            "scopes": {
              "read": "Read notes",
              "write": "Create notes and upload files"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "examples": [
              "note-1"
            ]
          },
          "body": {
            "type": "string",
            "examples": [
              "Buy milk"
            ]
          }
        },
        "required": [
          "id",
          "body"
        ],
        "additionalProperties": false
      },
      "Chunk": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "examples": [
              "echo"
            ]
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "NoteCreated": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "examples": [
              "note.created"
            ]
          },
          "note": {
            "$ref": "#/components/schemas/Note"
          }
        },
        "required": [
          "event",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "x-fern-idempotency-headers": [
    {
      "header": "Idempotency-Key",
      "name": "idempotency_key"
    }
  ],
  "x-fern-webhook-signature": {
    "type": "hmac",
    "header": "x-webhook-signature",
    "algorithm": "sha256",
    "encoding": "hex"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/oauth/token": {
      "post": {
        "operationId": "getToken",
        "summary": "OAuth client-credentials token (used by the SDK itself)",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "description": "client_credentials, the one grant",
                    "examples": [
                      "client_credentials"
                    ],
                    "type": "string"
                  },
                  "client_id": {
                    "examples": [
                      "id-1"
                    ],
                    "type": "string"
                  },
                  "client_secret": {
                    "examples": [
                      "secret-1"
                    ],
                    "type": "string"
                  },
                  "scope": {
                    "description": "The scopes asked for: a token here may read and write whatever is asked",
                    "type": "string"
                  },
                  "resource": {
                    "description": "The API the token is for (RFC 8707): this one",
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "examples": [
                        "Bearer"
                      ]
                    },
                    "expires_in": {
                      "type": "integer",
                      "format": "int32",
                      "examples": [
                        3600
                      ]
                    }
                  },
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-fern-audiences": [
          "public",
          "internal"
        ],
        "security": []
      }
    },
    "/api/notes": {
      "get": {
        "operationId": "listNotes",
        "summary": "List notes (cursor pagination)",
        "tags": [
          "notes"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from the previous page's next_cursor",
              "examples": [
                "2"
              ],
              "type": "string"
            },
            "description": "Opaque cursor from the previous page's next_cursor"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 2,
              "format": "int32",
              "examples": [
                2
              ],
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Note"
                      }
                    },
                    "next_cursor": {
                      "description": "Pass as cursor for the next page; absent on the last page",
                      "examples": [
                        "4"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-fern-audiences": [
          "public",
          "internal"
        ],
        "x-fern-pagination": {
          "cursor": "$request.cursor",
          "next_cursor": "$response.next_cursor",
          "results": "$response.data"
        }
      },
      "post": {
        "operationId": "createNote",
        "summary": "Create a note (idempotent: safe to retry with an Idempotency-Key)",
        "tags": [
          "notes"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string",
                    "examples": [
                      "Buy milk"
                    ]
                  }
                },
                "required": [
                  "body"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests: more than 100 calls in 60 s by this caller",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before calling again",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-fern-audiences": [
          "public",
          "internal"
        ],
        "x-fern-idempotent": true,
        "security": [
          {
            "bearer": [
              "write"
            ]
          },
          {
            "accessClientId": [
              "write"
            ],
            "accessClientSecret": []
          },
          {
            "oidc": [
              "write"
            ]
          },
          {
            "OAuth": [
              "write"
            ]
          }
        ],
        "x-rate-limit": {
          "binding": "WRITE_LIMIT",
          "limit": 100,
          "period": 60
        }
      }
    },
    "/api/notes/watch": {
      "get": {
        "operationId": "watchNotes",
        "summary": "Stream notes (Server-Sent Events) for `seconds`; call again with `after` = the last event's id to continue without gaps",
        "tags": [
          "notes"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "schema": {
              "description": "Resume after this event id (the last one you received). Absent: only notes created from now on",
              "examples": [
                "3"
              ],
              "type": "string",
              "pattern": "^\\d+$"
            },
            "description": "Resume after this event id (the last one you received). Absent: only notes created from now on"
          },
          {
            "in": "query",
            "name": "seconds",
            "schema": {
              "default": 30,
              "description": "How long to keep the stream open",
              "format": "int32",
              "examples": [
                30
              ],
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "description": "How long to keep the stream open"
          }
        ],
        "responses": {
          "200": {
            "description": "notes",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-fern-audiences": [
          "public",
          "internal"
        ],
        "x-fern-sdk-group-name": "notes",
        "x-fern-sdk-method-name": "watch",
        "x-fern-streaming": {
          "format": "sse",
          "terminator": "[end-of-stream]",
          "resumable": true
        }
      }
    },
    "/api/files": {
      "post": {
        "operationId": "uploadFile",
        "summary": "Upload a file (multipart)",
        "tags": [
          "files"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "contentMediaType": "application/octet-stream"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "examples": [
                        "file-1"
                      ]
                    },
                    "size": {
                      "type": "integer",
                      "format": "int32",
                      "examples": [
                        1024
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "size"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-fern-audiences": [
          "internal"
        ],
        "security": [
          {
            "bearer": [
              "write"
            ]
          },
          {
            "accessClientId": [
              "write"
            ],
            "accessClientSecret": []
          },
          {
            "oidc": [
              "write"
            ]
          },
          {
            "OAuth": [
              "write"
            ]
          }
        ]
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "chat",
        "summary": "Stream a reply (Server-Sent Events)",
        "tags": [
          "chat"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "examples": [
                      "Say hello"
                    ]
                  }
                },
                "required": [
                  "prompt"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "chunks",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Chunk"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-fern-audiences": [
          "public",
          "internal"
        ],
        "x-fern-streaming": {
          "format": "sse"
        }
      }
    }
  },
  "webhooks": {
    "noteCreated": {
      "post": {
        "operationId": "noteCreatedWebhook",
        "summary": "Sent to you when a note is created",
        "tags": [
          "notes"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteCreated"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "received"
          }
        }
      }
    }
  }
}

// The Worker: wrangler dev runs it, wrangler deploy ships it.
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "charter-notes",
  "main": "build/worker.mjs",
  "compatibility_date": "2026-09-25",
  // charter build writes build/: the Wasm, and the JavaScript that runs it.
  "build": { "command": "go tool charter build" },
  "vars": { "APP_NAME": "charter-notes" },
  // The notes. charter deploy applies migrations/ first.
  "d1_databases": [{ "binding": "DB", "database_name": "charter-notes", "database_id": "local", "migrations_dir": "migrations" }],
  // One hub: every stream of notes listens to it (charter's hub.mjs).
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // How often one caller may create notes: the contract's WriteLimit (api/contract.go), which charter check holds
  // this to.
  "ratelimits": [{ "name": "WRITE_LIMIT", "namespace_id": "2001", "simple": { "limit": 100, "period": 60 } }]
  // READ_TOKEN and WRITE_TOKEN are secrets (wrangler secret put); .dev.vars has throwaway ones for wrangler dev.
}

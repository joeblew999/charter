{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Showcase live",
    "version": "1.0.0"
  },
  "servers": {
    "production": {
      "host": "orpc-sdk-harness-api.gedw99.workers.dev",
      "pathname": "/api/mock",
      "protocol": "wss"
    }
  },
  "channels": {
    "liveNotes": {
      "address": "/notes/live",
      "messages": {
        "NoteEvent": {
          "$ref": "#/components/messages/NoteEvent"
        },
        "Subscribe": {
          "$ref": "#/components/messages/Subscribe"
        }
      }
    }
  },
  "operations": {
    "receiveNoteEvent": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/liveNotes"
      },
      "messages": [
        {
          "$ref": "#/channels/liveNotes/messages/NoteEvent"
        }
      ]
    },
    "sendSubscribe": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/liveNotes"
      },
      "messages": [
        {
          "$ref": "#/channels/liveNotes/messages/Subscribe"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "NoteEvent": {
        "name": "NoteEvent",
        "payload": {
          "type": "object",
          "properties": {
            "event": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "auth": {
              "description": "The Authorization value the server received on connecting: the harness test reads it",
              "type": "string"
            }
          },
          "required": [
            "event",
            "id"
          ],
          "additionalProperties": false
        }
      },
      "Subscribe": {
        "name": "Subscribe",
        "payload": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string"
            }
          },
          "required": [
            "topic"
          ]
        }
      }
    }
  }
}

// The Worker: wrangler dev runs it, wrangler deploy ships it.
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "charter-site",
  "main": "build/worker.mjs",
  "compatibility_date": "2026-09-25",
  // charter build writes dist/ (Vite) and build/ (the Wasm, and the JavaScript that runs it).
  "build": { "command": "go tool charter build" },
  // Vite's output, served before the Worker runs.
  "assets": { "directory": "dist" },
  "vars": { "APP_NAME": "charter-site" },
  // The log of messages. charter deploy applies migrations/ first.
  "d1_databases": [{ "binding": "DB", "database_name": "charter-site", "database_id": "local", "migrations_dir": "migrations" }],
  // One hub wakes every open page when a message is posted (charter's hub.mjs).
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // The Cloudflare page (/cloud): one binding of each kind, used through workers-go (pages/cloud_js.go).
  "kv_namespaces": [{ "binding": "KV", "id": "local" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "charter-site" }],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "charter-site" }],
    "consumers": [{ "queue": "charter-site", "max_batch_timeout": 1 }]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "send_email": [{ "name": "MAIL" }]
}

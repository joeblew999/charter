# Line ends are LF on every system: checks compare generated files byte for byte, and gofmt wants LF.
* text=auto eol=lf

# Generated files: nobody edits these by hand.
examples/*/fern/openapi.json    linguist-generated=true
examples/*/fern/asyncapi.json   linguist-generated=true
examples/*/fern/generators.yml  linguist-generated=true
examples/*/api/queries.go       linguist-generated=true
examples/*/sdk/go/**            linguist-generated=true
package-lock.json               linguist-generated=true

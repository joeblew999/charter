package screens

import (
	"github.com/gsxhq/gsx"
	"github.com/gsxhq/gsxui/ui"
	"github.com/gsxhq/gsxui/ui/icon"
	"github.com/joeblew999/charter/app"
	"github.com/joeblew999/charter/app/screens/locales"
	"strings"
)

// ThemePicker lets a reader choose among gsxui's themes as the page runs: the app's own, and every accent gsxui has
// for the app's style and base colour (app.Themes: amber, blue … yellow), each with its light and its dark. A
// theme changes CSS variables and nothing else, which is why it can be chosen in the browser: the choices are in
// web/gsxui/themes.css, which charter check --fix writes from gsxui itself, and <html data-theme> says which. The
// choice is kept by the browser and is there before the first paint (app.Head has the script, as for light and
// dark); these buttons only carry the attribute it listens for. Each swatch is the theme's own primary colour,
// from the same stylesheet, and the stylesheet marks the one in force.
//
// gsxui's styles (nova, lyra …) are not here: one is compiled into the components, and is changed while
// developing (charter run ui:theme). Extra attributes fall through to the button that opens the list.
//
// From charter add screen:theme-picker: the app's own now, to change as it likes.
component ThemePicker(attrs gsx.Attrs) {
	<ui.Popover>
		<ui.PopoverTrigger
			class="inline-flex size-8 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground"
			aria-label={locales.ScreensThemePick}
			title={locales.ScreensThemePick}
			data-theme-picker
			{ attrs... }
		>
			<icon.Palette class="size-4"/>
		</ui.PopoverTrigger>
		<ui.PopoverContent class="max-h-80 w-52 overflow-y-auto p-1">
			<div role="group" aria-label={locales.ScreensThemePick} class="grid gap-0.5">
				<ui.Button variant="ghost" size="sm" type="button" class="justify-start gap-2" data-theme-choice="">
					<span class="size-4 shrink-0 rounded-full border bg-muted-foreground"></span>
					<span class="flex-1 text-start">{ locales.ScreensThemeOwn }</span>
					<icon.Check class="size-4" data-theme-chosen/>
				</ui.Button>
				{ for _, name := range app.Themes() {
					<ui.Button variant="ghost" size="sm" type="button" class="justify-start gap-2" data-theme-choice={name}>
						<span class="size-4 shrink-0 rounded-full border bg-primary" data-theme={name}></span>
						<span class="flex-1 text-start" lang="en" dir="ltr">{ themeTitle(name) }</span>
						<icon.Check class="size-4" data-theme-chosen/>
					</ui.Button>
				} }
			</div>
		</ui.PopoverContent>
	</ui.Popover>
}

// themeTitle is a theme's name as gsxui's own theme editor shows it: Blue.
func themeTitle(name string) string {
	return strings.ToUpper(name[:1]) + name[1:]
}

{
  "components": {
    "schemas": {
      "CreateInputBody": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "examples": [
              "Hello, everyone"
            ],
            "maxLength": 280,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HelloOutputBody": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "examples": [
              "Hello from charter-start-htmx"
            ],
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "Message": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "examples": [
              "Hello, everyone"
            ],
            "type": "string"
          },
          "created_at": {
            "examples": [
              "2026-10-03 12:00:00"
            ],
            "type": "string"
          },
          "id": {
            "examples": [
              42
            ],
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "body",
          "created_at"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "charter-start-htmx: Huma contract (Go) -\u003e OpenAPI -\u003e Fern, and server-rendered pages (gsx, htmx 4).",
    "title": "charter-start-htmx",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/hello": {
      "get": {
        "operationId": "hello",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Say hello",
        "tags": [
          "meta"
        ],
        "x-fern-sdk-group-name": "meta",
        "x-fern-sdk-method-name": "hello"
      }
    },
    "/api/messages": {
      "get": {
        "operationId": "listMessages",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "examples": [
                20
              ],
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "The newest messages, newest first",
        "tags": [
          "messages"
        ],
        "x-fern-sdk-group-name": "messages",
        "x-fern-sdk-method-name": "list"
      },
      "post": {
        "description": "Every open page shows it at once: the pages' stream (/messages/stream) sends it as HTML.",
        "operationId": "createMessage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Post a message",
        "tags": [
          "messages"
        ],
        "x-fern-sdk-group-name": "messages",
        "x-fern-sdk-method-name": "create"
      }
    }
  },
  "servers": [
    {
      "url": "https://charter-start-htmx.gedw99.workers.dev"
    }
  ]
}

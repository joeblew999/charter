		"sdk:publish": "charter-ts sdk:publish",
		"deploy": "charter-ts deploy",
		"live-test": "charter-ts live-test"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@modelcontextprotocol/client": "2.2.0",
		"@types/node": "^22.12.0",
		"cf": "1.0.0-beta.5",
		"charter-ts": "^0.5.0",
		"fern-api": "5.140.0",
		"typescript": "~5.9.3",
		"vite": "^8.3.0"

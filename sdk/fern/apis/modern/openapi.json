{
  "openapi": "3.0.3",
  "info": { "title": "Modern", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com" }],
  "paths": {
    "/notes": {
      "get": {
        "operationId": "listNotes",
        "summary": "List notes, a page at a time (cursor pagination)",
        "tags": ["notes"],
        "x-fern-pagination": { "cursor": "$request.cursor", "next_cursor": "$response.next_cursor", "results": "$response.data" },
        "parameters": [
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "a page of notes",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["data"],
              "properties": {
                "data": { "type": "array", "items": { "$ref": "#/components/schemas/Note" } },
                "next_cursor": { "type": "string" }
              }
            } } }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "operationId": "chat",
        "summary": "Stream a reply as Server-Sent Events",
        "tags": ["chat"],
        "x-fern-streaming": { "format": "sse" },
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["prompt"], "properties": { "prompt": { "type": "string" } }
          } } }
        },
        "responses": {
          "200": {
            "description": "stream of chunks",
            "content": { "text/event-stream": { "schema": { "$ref": "#/components/schemas/Chunk" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Note": { "type": "object", "required": ["id", "body"], "properties": { "id": { "type": "string" }, "body": { "type": "string" } } },
      "Chunk": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "done": { "type": "boolean" } } }
    }
  }
}

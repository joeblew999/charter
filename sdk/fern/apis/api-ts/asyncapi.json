{
  "asyncapi": "3.0.0",
  "info": {
    "title": "orpc-api live",
    "version": "1.0.0"
  },
  "servers": {
    "production": {
      "host": "orpc-api.gedw99.workers.dev",
      "protocol": "wss"
    }
  },
  "channels": {
    "liveNotes": {
      "address": "/api/notes/live",
      "summary": "New notes over a WebSocket, as plain JSON. On close, reconnect with `after` = the last note id to continue without gaps",
      "messages": {
        "Note": {
          "$ref": "#/components/messages/Note"
        }
      },
      "bindings": {
        "ws": {
          "query": {
            "type": "object",
            "properties": {
              "after": {
                "description": "Resume after this note id (the id of the last note you received). Absent: only notes created from now on",
                "type": "string",
                "pattern": "^\\d+$"
              }
            }
          }
        }
      }
    }
  },
  "operations": {
    "receiveNote": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/liveNotes"
      },
      "messages": [
        {
          "$ref": "#/channels/liveNotes/messages/Note"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "Note": {
        "name": "Note",
        "payload": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "body": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "body",
            "created_at"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}

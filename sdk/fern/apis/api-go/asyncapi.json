{
  "asyncapi": "3.0.0",
  "channels": {
    "liveNotes": {
      "address": "/api/notes/live",
      "bindings": {
        "ws": {
          "query": {
            "properties": {
              "after": {
                "description": "Resume after this note id (the id of the last note you received). Absent: only notes created from now on",
                "pattern": "^\\d+$",
                "type": "string"
              }
            },
            "type": "object"
          }
        }
      },
      "messages": {
        "Note": {
          "$ref": "#/components/messages/Note"
        }
      },
      "summary": "New notes over a WebSocket, as plain JSON. On close, reconnect with `after` = the last note id to continue without gaps"
    }
  },
  "components": {
    "messages": {
      "Note": {
        "name": "Note",
        "payload": {
          "$ref": "#/components/schemas/Note"
        }
      }
    },
    "schemas": {
      "Note": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "body",
          "created_at"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "orpc-api-go live",
    "version": "1.0.0"
  },
  "operations": {
    "receiveNote": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/liveNotes"
      },
      "messages": [
        {
          "$ref": "#/channels/liveNotes/messages/Note"
        }
      ]
    }
  },
  "servers": {
    "production": {
      "host": "orpc-api-go.gedw99.workers.dev",
      "protocol": "wss"
    }
  }
}

{
  "components": {
    "schemas": {
      "CreateInputBody": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "examples": [
              "Buy milk"
            ],
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HelloOutputBody": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "examples": [
              "Hello from orpc-api-go"
            ],
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Note"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Pass as cursor for the next page; absent on the last page",
            "examples": [
              "41"
            ],
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "Note": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "examples": [
              "Buy milk"
            ],
            "type": "string"
          },
          "created_at": {
            "examples": [
              "2026-10-01 12:00:00"
            ],
            "type": "string"
          },
          "id": {
            "examples": [
              42
            ],
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "body",
          "created_at"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Notes API: Huma contract (Go) -\u003e OpenAPI -\u003e Fern.",
    "title": "orpc-api-go",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/hello": {
      "get": {
        "operationId": "hello",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Say hello",
        "tags": [
          "meta"
        ],
        "x-fern-sdk-group-name": "meta",
        "x-fern-sdk-method-name": "hello"
      }
    },
    "/api/notes": {
      "get": {
        "operationId": "listNotes",
        "parameters": [
          {
            "description": "Opaque cursor from the previous page's next_cursor",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from the previous page's next_cursor",
              "examples": [
                "42"
              ],
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "examples": [
                20
              ],
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List notes, newest first (cursor pagination)",
        "tags": [
          "notes"
        ],
        "x-fern-pagination": {
          "cursor": "$request.cursor",
          "next_cursor": "$response.next_cursor",
          "results": "$response.data"
        },
        "x-fern-sdk-group-name": "notes",
        "x-fern-sdk-method-name": "list"
      },
      "post": {
        "operationId": "createNote",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create a note",
        "tags": [
          "notes"
        ],
        "x-fern-sdk-group-name": "notes",
        "x-fern-sdk-method-name": "create"
      }
    },
    "/api/notes/watch": {
      "get": {
        "description": "Each event's SSE id is the note id, so a browser EventSource resumes by itself (Last-Event-ID).",
        "operationId": "watchNotes",
        "parameters": [
          {
            "description": "Resume after this note id (the id of the last note you received). Absent: only notes created from now on",
            "explode": false,
            "in": "query",
            "name": "after",
            "schema": {
              "description": "Resume after this note id (the id of the last note you received). Absent: only notes created from now on",
              "examples": [
                "42"
              ],
              "pattern": "^\\d+$",
              "type": "string"
            }
          },
          {
            "description": "How long to keep the stream open",
            "explode": false,
            "in": "query",
            "name": "seconds",
            "schema": {
              "default": 30,
              "description": "How long to keep the stream open",
              "examples": [
                30
              ],
              "format": "int32",
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Stream notes as they are created (Server-Sent Events). The stream ends after `seconds`; call again with `after` = the last note id to continue without gaps",
        "tags": [
          "notes"
        ],
        "x-fern-sdk-group-name": "notes",
        "x-fern-sdk-method-name": "watch",
        "x-fern-streaming": {
          "format": "sse",
          "resumable": true,
          "terminator": "[end-of-stream]"
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://orpc-api-go.gedw99.workers.dev"
    }
  ]
}

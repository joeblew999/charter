{
  "asyncapi": "3.0.0",
  "channels": {
    "liveNotes": {
      "address": "/notes/live",
      "bindings": {
        "ws": {
          "query": {
            "properties": {
              "access_token": {
                "description": "The OAuth token, for clients that can't send WebSocket headers (browsers, Workers). Others send Authorization",
                "type": "string"
              }
            },
            "type": "object"
          }
        }
      },
      "messages": {
        "NoteEvent": {
          "$ref": "#/components/messages/NoteEvent"
        },
        "Subscribe": {
          "$ref": "#/components/messages/Subscribe"
        }
      },
      "summary": "Note events over a WebSocket: send `subscribe` with a topic, receive that topic's events"
    }
  },
  "components": {
    "messages": {
      "NoteEvent": {
        "name": "NoteEvent",
        "payload": {
          "$ref": "#/components/schemas/NoteEvent"
        }
      },
      "Subscribe": {
        "name": "Subscribe",
        "payload": {
          "$ref": "#/components/schemas/Subscribe"
        }
      }
    },
    "schemas": {
      "NoteEvent": {
        "additionalProperties": false,
        "properties": {
          "auth": {
            "description": "The Authorization the server saw on this socket",
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "event",
          "id"
        ],
        "type": "object"
      },
      "Subscribe": {
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string"
          }
        },
        "required": [
          "topic"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Showcase live",
    "version": "1.0.0"
  },
  "operations": {
    "receiveNoteEvent": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/liveNotes"
      },
      "messages": [
        {
          "$ref": "#/channels/liveNotes/messages/NoteEvent"
        }
      ]
    },
    "sendSubscribe": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/liveNotes"
      },
      "messages": [
        {
          "$ref": "#/channels/liveNotes/messages/Subscribe"
        }
      ]
    }
  },
  "servers": {
    "production": {
      "host": "orpc-showcase-go.gedw99.workers.dev",
      "protocol": "wss"
    }
  }
}

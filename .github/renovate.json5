// Renovate keeps what this repository pins current, in a pull request a week: the tools of mise.toml (Go, Node,
// fnox) and mise.lock, Go's modules, npm's packages, and the GitHub Actions. Dependabot's security alerts stay on in
// the repository's settings; its version updates are Renovate's now, since Dependabot does not read mise.toml.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  schedule: ["before 6am on monday"],
  // go mod tidy -e: an app's components are .gsx, whose Go is generated and not committed, so a plain tidy in a fresh
  // checkout stops at them. With -e it goes on, and gives the go.mod and go.sum a tidy after generating them gives
  // (tried on example/ and site/). And it is run in every module that uses the one updated through a local replace
  // (example/ and site/ use charter's root module so), so their go.sum follow an update of the library's.
  postUpdateOptions: ["gomodTidyE", "gomodTidyAll"],
  // Before tidying, Renovate runs go get -t on these, which needs every package they match to be there. In an app,
  // pages/screens and ui are .gsx until charter generates their Go, so it asks only of locales, whose Go is
  // committed (in charter's root module it matches nothing, which go only warns of); the tidy after it does the rest.
  // Tried on all three modules: the go.mod and go.sum are what a tidy after generating gives.
  goGetDirs: ["./locales/..."],
  // example/ and site/ build against the checkout beside them (go.mod's replace): their charter is this one.
  ignoreDeps: ["github.com/joeblew999/charter"],
  // The API's clients are written by Fern (go tool charter pack), go.mod and all: Fern decides what they depend on.
  ignorePaths: ["**/node_modules/**", "example/sdk/**"],
  packageRules: [
    {
      // go.mod's go line is the oldest Go an app may build charter with: raised on purpose, never by a bot.
      // The Go everything is built with is mise.toml's.
      matchManagers: ["gomod"],
      matchDepTypes: ["golang"],
      enabled: false,
    },
    { matchManagers: ["gomod"], groupName: "go modules" },
    { matchManagers: ["npm"], groupName: "npm" },
    {
      // gsx's Vite plugin says which Vite it works with (its peer dependency): a new major waits for it.
      matchManagers: ["npm"],
      matchPackageNames: ["vite"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    { matchManagers: ["mise"], groupName: "tools" },
    { matchManagers: ["github-actions"], groupName: "actions" },
  ],
}

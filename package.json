{
	"name": "charter",
	"private": true,
	"type": "module",
	"description": "Contract-first APIs on Cloudflare Workers with Huma (Go) or oRPC (TypeScript): OpenAPI and AsyncAPI generated, SDKs in any language with Fern, a CLI, MCP and real-time. Go at TypeScript's cost.",
	"keywords": [
		"asyncapi",
		"cloudflare-workers",
		"contract-first",
		"d1",
		"durable-objects",
		"fern",
		"golang",
		"huma",
		"mcp",
		"openapi",
		"orpc",
		"sdk-generator",
		"sse",
		"tinygo",
		"typescript",
		"websocket",
		"workers-go"
	],
	"homepage": "https://joeblew999.github.io/charter/",
	"workspaces": [
		"ts/lib",
		"charter-ts",
		"ts/start",
		"ts/notes",
		"ts/showcase",
		"go/notes",
		"go/start",
		"go/start-htmx",
		"go/start-datastar",
		"go/showcase"
	],
	"scripts": {
		"prepare": "npm run build -w ts/lib -w charter-ts",
		"adopt": "charter-ts adopt",
		"repo": "charter-ts repo",
		"issues": "charter-ts issues",
		"issue": "charter-ts issue",
		"check": "tsc && npm run check --workspaces && charter-ts docs:check",
		"docs:check": "charter-ts docs:check",
		"repo:ci": "charter-ts repo:ci",
		"docs:review": "charter-ts docs:review",
		"release": "node release.ts"
	},
	"allowScripts": {
		"workerd": true,
		"esbuild": false,
		"fsevents": false,
		"@scarf/scarf": false
	}
}

{
  "info": {
    "title": "charter-notes-ts",
    "version": "1.0.0",
    "description": "Notes API: contract -> OpenAPI -> Fern."
  },
  "servers": [
    {
      "url": "https://charter-notes-ts.gedw99.workers.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "accessClientId": {
        "type": "apiKey",
        "in": "header",
        "name": "CF-Access-Client-Id",
        "description": "A Cloudflare Access service token's Client ID: a machine's own (cf zero-trust access service-tokens create)",
        "x-fern-header": {
          "name": "accessClientId",
          "env": "CHARTER_NOTES_TS_ACCESS_CLIENT_ID"
        }
      },
      "accessClientSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "CF-Access-Client-Secret",
        "description": "The service token's Client Secret",
        "x-fern-header": {
          "name": "accessClientSecret",
          "env": "CHARTER_NOTES_TS_ACCESS_CLIENT_SECRET"
        }
      },
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "/.well-known/openid-configuration",
        "description": "An access token from the OpenID Connect issuer the deployment trusts (OIDC_ISSUER), with the operation's scopes"
      }
    },
    "schemas": {
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "examples": [
              42
            ]
          },
          "body": {
            "type": "string",
            "examples": [
              "Buy milk"
            ]
          },
          "created_at": {
            "type": "string",
            "examples": [
              "2026-10-01 12:00:00"
            ]
          }
        },
        "required": [
          "id",
          "body",
          "created_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/hello": {
      "get": {
        "operationId": "hello",
        "summary": "Say hello",
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "examples": [
                        "Hello from charter-notes-ts"
                      ]
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-fern-sdk-group-name": "meta",
        "x-fern-sdk-method-name": "hello",
        "security": []
      }
    },
    "/api/notes": {
      "get": {
        "operationId": "listNotes",
        "summary": "List notes, newest first (cursor pagination)",
        "tags": [
          "notes"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from the previous page's next_cursor",
              "examples": [
                "42"
              ],
              "type": "string"
            },
            "description": "Opaque cursor from the previous page's next_cursor"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "format": "int32",
              "examples": [
                20
              ],
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Note"
                      }
                    },
                    "next_cursor": {
                      "description": "Pass as cursor for the next page; absent on the last page",
                      "examples": [
                        "41"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-fern-sdk-group-name": "notes",
        "x-fern-sdk-method-name": "list",
        "x-fern-pagination": {
          "cursor": "$request.cursor",
          "next_cursor": "$response.next_cursor",
          "results": "$response.data"
        },
        "security": []
      },
      "post": {
        "operationId": "createNote",
        "summary": "Create a note",
        "tags": [
          "notes"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "examples": [
                      "Buy milk"
                    ]
                  }
                },
                "required": [
                  "body"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests: more than 100 calls in 60 s by this caller",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before calling again",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-fern-sdk-group-name": "notes",
        "x-fern-sdk-method-name": "create",
        "x-rate-limit": {
          "binding": "WRITE_LIMIT",
          "limit": 100,
          "period": 60
        },
        "security": [
          {
            "bearer": [
              "write"
            ]
          },
          {
            "accessClientId": [
              "write"
            ],
            "accessClientSecret": []
          },
          {
            "oidc": [
              "write"
            ]
          }
        ]
      }
    },
    "/api/notes/watch": {
      "get": {
        "operationId": "watchNotes",
        "summary": "Stream notes as they are created (Server-Sent Events). The stream ends after `seconds`; call again with `after` = the last note id to continue without gaps",
        "description": "Each event's SSE id is the note id, so a browser EventSource resumes by itself (Last-Event-ID).",
        "tags": [
          "notes"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "schema": {
              "description": "Resume after this note id (the id of the last note you received). Absent: only notes created from now on",
              "examples": [
                "42"
              ],
              "type": "string",
              "pattern": "^\\d+$"
            },
            "description": "Resume after this note id (the id of the last note you received). Absent: only notes created from now on"
          },
          {
            "in": "query",
            "name": "seconds",
            "schema": {
              "default": 30,
              "description": "How long to keep the stream open",
              "format": "int32",
              "examples": [
                30
              ],
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "description": "How long to keep the stream open"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        },
        "x-fern-sdk-group-name": "notes",
        "x-fern-sdk-method-name": "watch",
        "x-fern-streaming": {
          "format": "sse",
          "terminator": "[end-of-stream]",
          "resumable": true
        },
        "security": []
      }
    }
  }
}

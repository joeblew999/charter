{
  "info": {
    "title": "charter-notes-ts",
    "version": "1.0.0",
    "description": "Notes API: oRPC contract -> OpenAPI -> Fern."
  },
  "servers": [
    {
      "url": "https://charter-notes-ts.gedw99.workers.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "accessClientId": {
        "type": "apiKey",
        "in": "header",
        "name": "CF-Access-Client-Id",
        "description": "A Cloudflare Access service token's Client ID: a machine's own (charter access token create)",
        "x-fern-header": {
          "name": "accessClientId",
          "env": "CHARTER_NOTES_TS_ACCESS_CLIENT_ID"
        }
      },
      "accessClientSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "CF-Access-Client-Secret",
        "description": "The service token's Client Secret",
        "x-fern-header": {
          "name": "accessClientSecret",
          "env": "CHARTER_NOTES_TS_ACCESS_CLIENT_SECRET"
        }
      },
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "/.well-known/openid-configuration",
        "description": "An access token from the OpenID Connect issuer the deployment trusts (OIDC_ISSUER), with the operation's scopes"
      }
    }
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/hello": {
      "get": {
        "operationId": "hello",
        "summary": "Say hello",
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "x-fern-sdk-group-name": "meta",
        "x-fern-sdk-method-name": "hello",
        "security": []
      }
    },
    "/api/notes": {
      "get": {
        "operationId": "listNotes",
        "summary": "List notes, newest first (cursor pagination)",
        "tags": [
          "notes"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from the previous page's next_cursor",
              "type": "string"
            },
            "allowEmptyValue": true,
            "allowReserved": true
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "allowEmptyValue": true,
            "allowReserved": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "body": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "body",
                          "created_at"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "next_cursor": {
                      "description": "Pass as cursor for the next page; absent on the last page",
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "x-fern-sdk-group-name": "notes",
        "x-fern-sdk-method-name": "list",
        "x-fern-pagination": {
          "cursor": "$request.cursor",
          "next_cursor": "$response.next_cursor",
          "results": "$response.data"
        },
        "security": []
      },
      "post": {
        "operationId": "createNote",
        "summary": "Create a note",
        "tags": [
          "notes"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "body"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "body": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "body",
                    "created_at"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests: more than 100 calls in 60 s by this caller",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before calling again",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "x-fern-sdk-group-name": "notes",
        "x-fern-sdk-method-name": "create",
        "x-rate-limit": {
          "binding": "WRITE_LIMIT",
          "limit": 100,
          "period": 60
        },
        "security": [
          {
            "bearer": [
              "write"
            ]
          },
          {
            "accessClientId": [
              "write"
            ],
            "accessClientSecret": []
          },
          {
            "oidc": [
              "write"
            ]
          }
        ]
      }
    },
    "/api/notes/watch": {
      "get": {
        "operationId": "watchNotes",
        "summary": "Stream notes as they are created (Server-Sent Events). The stream ends after `seconds`; call again with `after` = the last note id to continue without gaps",
        "description": "Each event's SSE id is the note id, so a browser EventSource resumes by itself (Last-Event-ID).",
        "tags": [
          "notes"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "schema": {
              "description": "Resume after this note id (the id of the last note you received). Absent: only notes created from now on",
              "type": "string",
              "pattern": "^\\d+$"
            },
            "allowEmptyValue": true,
            "allowReserved": true
          },
          {
            "in": "query",
            "name": "seconds",
            "schema": {
              "default": 30,
              "description": "How long to keep the stream open",
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "allowEmptyValue": true,
            "allowReserved": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "body": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "body",
                    "created_at"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "x-fern-sdk-group-name": "notes",
        "x-fern-sdk-method-name": "watch",
        "x-fern-streaming": {
          "format": "sse",
          "terminator": "[end-of-stream]",
          "resumable": true
        },
        "security": []
      }
    }
  }
}

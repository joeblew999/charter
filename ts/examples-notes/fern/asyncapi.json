{
  "asyncapi": "3.0.0",
  "info": {
    "title": "charter-notes-ts live",
    "version": "1.0.0"
  },
  "servers": {
    "production": {
      "host": "charter-notes-ts.gedw99.workers.dev",
      "protocol": "wss"
    }
  },
  "channels": {
    "liveNotes": {
      "address": "/api/notes/live",
      "summary": "New notes over a WebSocket, as plain JSON. On close, reconnect with `after` = the last note id to continue without gaps",
      "messages": {
        "Note": {
          "$ref": "#/components/messages/Note"
        }
      },
      "bindings": {
        "ws": {
          "query": {
            "type": "object",
            "properties": {
              "after": {
                "description": "Resume after this note id (the id of the last note you received). Absent: only notes created from now on",
                "examples": [
                  "42"
                ],
                "type": "string",
                "pattern": "^\\d+$"
              }
            }
          }
        }
      }
    }
  },
  "operations": {
    "receiveNote": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/liveNotes"
      },
      "messages": [
        {
          "$ref": "#/channels/liveNotes/messages/Note"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "Note": {
        "name": "Note",
        "payload": {
          "$ref": "#/components/schemas/Note"
        }
      }
    },
    "schemas": {
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "examples": [
              42
            ]
          },
          "body": {
            "type": "string",
            "examples": [
              "Buy milk"
            ]
          },
          "created_at": {
            "type": "string",
            "examples": [
              "2026-10-01 12:00:00"
            ]
          }
        },
        "required": [
          "id",
          "body",
          "created_at"
        ],
        "additionalProperties": false
      }
    }
  }
}

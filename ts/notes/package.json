{
	"name": "charter-notes-ts",
	"private": true,
	"type": "module",
	"description": "The notes API in TypeScript on Cloudflare Workers, from an oRPC contract. npm run check is every local check; the steps are the scripts below, in the order you run them: each is charter-ts <step>, which reads charter.config.ts.",
	"scripts": {
		"lint": "charter-ts lint",
		"spec": "charter-ts spec",
		"spec:check": "charter-ts spec:check",
		"dev": "charter-ts dev",
		"migrate:local": "charter-ts migrate:local",
		"test:workerd": "charter-ts test:workerd",
		"check": "npm run lint && npm run spec:check && npm run test:workerd",
		"sdk": "charter-ts sdk",
		"deploy": "charter-ts deploy",
		"live-test": "charter-ts live-test"
	},
	"dependencies": {
		"@orpc/cloudflare": "2.0.0-beta.40",
		"@orpc/contract": "2.0.0-beta.40",
		"@orpc/json-schema": "2.0.0-beta.40",
		"@orpc/openapi": "2.0.0-beta.40",
		"@orpc/server": "2.0.0-beta.40",
		"@orpc/zod": "2.0.0-beta.40",
		"charter-ts": "^0.1.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@types/node": "^22.12.0",
		"@types/ws": "^8.5.12",
		"cf": "1.0.0-beta.5",
		"fern-api": "5.140.0",
		"jose": "6.2.12",
		"typescript": "^7.0.2",
		"typescript-sdk": "npm:typescript@~5.9.3",
		"vite": "^8.3.0",
		"ws": "^8.18.0"
	}
}

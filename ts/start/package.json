{
	"name": "charter-start-ts",
	"private": true,
	"type": "module",
	"description": "The start of a TypeScript API on Cloudflare Workers, from an oRPC contract (src/contract.ts). npm run check is every local check (no Cloudflare account); npm run dev runs it locally; npx charter-ts lists every step.",
	"scripts": {
		"dev": "charter-ts dev",
		"check": "charter-ts check",
		"spec": "charter-ts spec",
		"sdk": "charter-ts sdk",
		"deploy": "charter-ts deploy",
		"live-test": "charter-ts live-test"
	},
	"dependencies": {
		"@orpc/contract": "2.0.0-beta.40",
		"@orpc/json-schema": "2.0.0-beta.40",
		"@orpc/openapi": "2.0.0-beta.40",
		"@orpc/server": "2.0.0-beta.40",
		"@orpc/zod": "2.0.0-beta.40",
		"charter-lib": "^0.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@types/node": "^22.12.0",
		"cf": "1.0.0-beta.5",
		"charter-ts": "^0.4.0",
		"fern-api": "5.140.0",
		"typescript": "^7.0.2",
		"typescript-sdk": "npm:typescript@~5.9.3",
		"vite": "^8.3.0"
	}
}

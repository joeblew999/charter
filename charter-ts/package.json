{
	"name": "charter-ts",
	"version": "0.7.0",
	"description": "A repo kept the charter way, and APIs on Cloudflare Workers in TypeScript or Go, step by step: the charter-ts command. For any repo: adopt (the kit), docs:check, issue, upstream:status, repo, repo:ci. For a project, from its charter.config.ts: new, dev, check, spec, sdk, deploy, live-test (and in Go: run, build, sdk:publish). The library a TypeScript Worker imports is charter-lib (ts/lib). Installed from its GitHub Release: npm i -D https://github.com/joeblew999/charter/releases/download/ts-vX.Y.Z/charter-ts-X.Y.Z.tgz",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/joeblew999/charter.git",
		"directory": "charter-ts"
	},
	"homepage": "https://joeblew999.github.io/charter/",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"bin": {
		"charter-ts": "./bin/charter-ts.js"
	},
	"files": [
		"bin",
		"dist",
		"kit",
		"review.md",
		"templates",
		"tsconfig.node.json",
		"tsconfig.worker.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc && node --test test/*.test.ts && npm run build",
		"prepack": "npm run build && node pack-templates.ts"
	},
	"exports": {
		"./config": {
			"types": "./dist/config.d.ts",
			"default": "./dist/config.js"
		},
		"./cloudflare": {
			"types": "./dist/cloudflare.d.ts",
			"default": "./dist/cloudflare.js"
		},
		"./spec-files": {
			"types": "./dist/spec-files.d.ts",
			"default": "./dist/spec-files.js"
		},
		"./scripts": {
			"types": "./dist/scripts.d.ts",
			"default": "./dist/scripts.js"
		},
		"./new": {
			"types": "./dist/new.d.ts",
			"default": "./dist/new.js"
		},
		"./package": {
			"types": "./dist/package.d.ts",
			"default": "./dist/package.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./tsconfig.node.json": "./tsconfig.node.json",
		"./tsconfig.worker.json": "./tsconfig.worker.json",
		"./ci": {
			"types": "./dist/ci.d.ts",
			"default": "./dist/ci.js"
		}
	},
	"peerDependencies": {
		"@cloudflare/vite-plugin": "*",
		"vite": "*"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@types/node": "^22.12.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	},
	"peerDependenciesMeta": {
		"@cloudflare/vite-plugin": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	}
}

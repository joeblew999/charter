{
	"//": "What a TypeScript project's tsconfig.json extends: the Worker, with cf's types and no Node.",
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	}
}

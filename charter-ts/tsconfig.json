{
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"es2024"
		],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [
			"node"
		],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": [
		"src",
		"test",
		"pack-templates.ts",
		"kit/ci.config.ts"
	]
}

// The Worker: wrangler dev runs it, wrangler deploy ships it.
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "charter-example",
  "main": "build/worker.mjs",
  "compatibility_date": "2026-09-25",
  // Cloudflare tells the Worker when a reader has left (request.signal): a handler that waits then returns. The
  // default from compatibility date 2026-11-17.
  "compatibility_flags": ["enable_request_signal"],
  // Workers Logs: what the Worker printed and how each request ended, kept by Cloudflare, so a failure that is over
  // can still be read (go tool charter run logs follows them live).
  "observability": { "enabled": true },
  // Cloudflare's cache for the Worker, asked before the Worker runs: a page that says it is the same for every reader
  // (its type's Shared) is answered from it, with no Worker started. A deploy starts an empty one.
  "cache": { "enabled": true },
  // charter build writes dist/ (Vite) and build/ (the Wasm, and the JavaScript that runs it). Under charter dev the
  // Worker stays running across builds: charter writes into watch_dir when there is a new one, and wrangler takes it.
  "build": { "command": "go tool charter build", "watch_dir": ".charter/built" },
  // Vite's output, served before the Worker runs.
  "assets": { "directory": "dist" },
  // MAIL_FROM is whom the email card writes as: an address on a domain of the account with Email Routing on. Whom
  // it writes to is the secret MAIL_TO (wrangler secret put MAIL_TO; .dev.vars locally). MAIL_UNLIMITED, when it is
  // anything, lets the card send more than one message an hour: for an environment that is no one's public page.
  "vars": { "APP_NAME": "charter-example", "MAIL_FROM": "charter-example@ubuntusoftware.net", "MAIL_UNLIMITED": "" },
  // The first deploy makes the database, the KV namespace, the bucket and the queue. charter deploy then writes the
  // database's and the namespace's ids here: the Worker is bound to exactly those from then on. A bucket and a queue
  // are what they are by name.
  // The log of messages. charter deploy applies migrations/ first.
  "d1_databases": [{ "binding": "DB", "database_name": "charter-example", "migrations_dir": "db/migrations", "database_id": "2f1ba582-8c74-47f3-b617-3ec07d65f323" }],
  // One hub wakes every open page when a message is posted (charter's hub.mjs).
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // The Cloudflare page (/bindings): one binding of each kind, used through workers-go (package bindings).
  "kv_namespaces": [{ "binding": "KV", "id": "cfa697f605604bddbf81d57c8be01b04" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "charter-example" }],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "charter-example" }],
    "consumers": [{ "queue": "charter-example", "max_batch_timeout": 1 }]
  },
  // How often one caller may create notes: the contract's WriteLimit (api/contract.go), which charter check holds
  // this to.
  "ratelimits": [{ "name": "WRITE_LIMIT", "namespace_id": "2001", "simple": { "limit": 100, "period": 60 } }],
  // Once a day the activity page gets the day's count (package built).
  "triggers": { "crons": ["0 6 * * *"] },
  "send_email": [{ "name": "MAIL" }]
}
